# ── Database ──────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/mentormate
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# ── JWT ───────────────────────────────────────────────────────────────
# Must be a Base64-encoded string of at least 32 characters (256 bits)
JWT_SECRET=bWVudG9ybWF0ZS1zdXBlci1zZWNyZXQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9u
JWT_EXPIRATION=86400000

# ── Server ────────────────────────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── Frontend (Next.js) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
